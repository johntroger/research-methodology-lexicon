rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Cho phép đọc và đồng bộ danh mục thuật ngữ
    match /methodology_terms/{document=**} {
      allow read, write: if true;
    }

    match /acronyms/{document=**} {
      allow read, write: if true;
    }

    // 2. Cho phép người dùng gửi góp ý / báo lỗi
    match /feedbacks/{document=**} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // 3. Cho phép người dùng lưu và đọc bookmarks cá nhân
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }

    // 4. Cho phép người dùng gửi bản đề xuất chỉnh sửa mục từ (Wiki Revision)
    match /pending_revisions/{document=**} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // 5. Cho phép người dùng gửi đề xuất thuật ngữ mới
    match /pending_terms/{document=**} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // 6. Cho phép đọc và thảo luận học thuật trên từng mục từ (Talk Page)
    match /discussions/{document=**} {
      allow read, write: if true;
    }
  }
}
